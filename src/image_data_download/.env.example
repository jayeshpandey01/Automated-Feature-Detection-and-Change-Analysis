# NASA Earthdata: https://urs.earthdata.nasa.gov/
NASA_USER="your_email@example.com"
NASA_PASS="your_password"
#
# Copernicus Data Space Ecosystem: https://dataspace.copernicus.eu/
CDSE_USER="your_email@example.com"
CDSE_PASS="your_password"
#
# USGS EROS Registration System: https://ers.cr.usgs.gov/
USGS_USER="your_email@example.com"
USGS_PASS="your_password"
