# =============================================================================
# GlacioWatch — Backend Environment Variables
# =============================================================================
# Copy this file to .env in the same folder (src/backend/) and fill in values.
# Never commit the actual .env file — it is already in .gitignore.
# =============================================================================


# ─────────────────────────────────────────────
# 📦 MONGODB
# ─────────────────────────────────────────────
# Local MongoDB (default — no change needed if running locally)
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=glacier_india_db

# Remote MongoDB Atlas (uncomment and fill if using Atlas cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# DB_NAME=glacier_india_db


# ─────────────────────────────────────────────
# 📧 SMTP — EMAIL / OTP DELIVERY
# ─────────────────────────────────────────────
# Without this, OTPs are saved as HTML files in logs/sent_emails/ (mock mode).
#
# ► Gmail setup:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Create an App Password for "Mail" + "Windows Computer"
#   3. Paste the 16-character password below (no spaces)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jayeshpandey754@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password_here
SENDER_EMAIL=jayeshpandey754@gmail.com


# ─────────────────────────────────────────────
# 🔥 FIREBASE ADMIN SDK (Backend)
# ─────────────────────────────────────────────
# Path to the Firebase service account JSON file.
# The file already exists in the project root — just set the path below.
# Leave blank to auto-detect the file from the project root.
#
FIREBASE_SERVICE_ACCOUNT=C:/Users/jayes/Downloads/Night_mare/glacier-watch-1c62b-firebase-adminsdk-fbsvc-4a1fb004c4.json


# ─────────────────────────────────────────────
# 🌐 API SERVER
# ─────────────────────────────────────────────
# Port the FastAPI backend listens on
API_PORT=8000
API_HOST=0.0.0.0
